{
  "manifest_version": 3,
  "name": "gamesenseloader",
  "version": "1.0.2",
  "description": "Loads the current source client on devast.io.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "host_permissions": [
    "https://software-shldv.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://devast.io/*",
        "https://www.devast.io/*"
      ],
      "js": [
        "loader.js"
      ],
      "run_at": "document_start"
    }
  ]
}
