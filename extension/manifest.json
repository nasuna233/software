{
  "manifest_version": 3,
  "name": "Source Client Loader",
  "version": "1.0.1",
  "description": "Loads the current source client on devast.io.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://software-shldv.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://devast.io/*",
        "https://www.devast.io/*"
      ],
      "js": [
        "loader.js"
      ],
      "run_at": "document_start"
    }
  ]
}
